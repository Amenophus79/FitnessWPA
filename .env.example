# Optional Supabase sync/auth integration.
# Leave empty to run the local offline-first demo without Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional OpenAI plan generation integration.
# Leave OPENAI_API_KEY empty to run the app without OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# Local JSON file persistence for Docker/Node runs.
# Direct local Node.js runs use this path as-is.
LOCAL_DATA_DIR=./data

# Docker runs mount this host directory into the container.
# Use an absolute path to keep data outside the repository, for example:
# LOCAL_DATA_HOST_DIR=/Users/you/FitnessPWA-storage
LOCAL_DATA_HOST_DIR=./data

# Internal container mount path. Usually keep this unchanged.
LOCAL_DATA_CONTAINER_DIR=/app/data
